import re
from typing import Any, Literal, overload

import httpx

from .models import *

# Maps Python argument names (snake_case, collision suffixes) back to the
# original parameter names the API expects.
_PARAM_MAP: dict[tuple[str, str], dict[str, dict[str, str]]] = {
    {%- for op in operations %}
    ("{{ op.method }}", "{{ op.path }}"): {
        "path": {
            {%- for p in op.args if p.in_ == 'path' %}"{{ p.name }}": "{{ p.api_name }}",{% endfor -%}
        },
        "query": {
            {%- for p in op.args if p.in_ == 'query' %}"{{ p.name }}": "{{ p.api_name }}",{% endfor -%}
        },
        "header": {
            {%- for p in op.args if p.in_ == 'header' %}"{{ p.name }}": "{{ p.api_name }}",{% endfor -%}
        },
        "cookie": {
            {%- for p in op.args if p.in_ == 'cookie' %}"{{ p.name }}": "{{ p.api_name }}",{% endfor -%}
        },
    },
    {%- endfor %}
}


def _prepare_request(
    client: httpx.Client | httpx.AsyncClient,
    method: str,
    path: str,
    json: Any,
    data: Any,
    files: Any,
    content: Any,
    params: dict[str, Any],
) -> httpx.Request:
    """Validates and categorizes parameters, then builds the httpx request."""
    # Ensure all required parameters are set
    # (i.e., no REQUIRED sentinel should be left)
    for k, v in params.items():
        if isinstance(v, RequiredType):
            raise TypeError(f"Missing required parameter: {k}")

    # Filter out UNSET, i.e. optional, parameters.
    # -> Any UNSET values are omitted from the request.
    # None values for nullable parameters are kept.
    clean_params = {
        k: v for k, v in params.items()
        if not isinstance(v, UnsetType)
    }

    # Parameter Categorization via Static Map
    spec = _PARAM_MAP.get((method, path))
    path_vals: dict[str, Any] = {}
    query_vals: dict[str, Any] = {}
    header_vals: dict[str, Any] = {}
    cookie_vals: dict[str, Any] = {}

    if spec is None:
        # Escape hatch: path not defined in the OpenAPI spec. Fill any
        # {placeholders} from kwargs and send the rest as query params.
        placeholders = set(re.findall(r"\{([^}]+)\}", path))
        for k, v in clean_params.items():
            (path_vals if k in placeholders else query_vals)[k] = v
    else:
        # Map snake_case args back to API parameter names
        path_map = spec.get("path", {})
        query_map = spec.get("query", {})
        header_map = spec.get("header", {})
        cookie_map = spec.get("cookie", {})

        # Map values to their respective locations
        # and API parameter names
        unknown_params = []
        for k, v in clean_params.items():
            if k in path_map:
                # Path params use snake_case key since path template is normalized
                path_vals[k] = v
            elif k in query_map:
                query_vals[query_map[k]] = v
            elif k in header_map:
                header_vals[header_map[k]] = v
            elif k in cookie_map:
                cookie_vals[cookie_map[k]] = v
            else:
                unknown_params.append(k)

        if unknown_params:
            raise TypeError(
                f"Unknown parameter(s) {unknown_params!r} for {method} {path}. "
                "Request bodies use the json/data/files/content arguments."
            )

    try:
        formatted_path = path.format(**path_vals)
    except KeyError as e:
        # Re-raise with a clear error if a path parameter is missing
        raise TypeError(f"Missing required path parameter: {e}") from e

    return client.build_request(
        method,
        formatted_path,
        json=json,
        data=data,
        files=files,
        content=content,
        params=query_vals,
        headers=header_vals,
        cookies=cookie_vals,
    )


{#- Macro rendering a full client class, parametrized over sync/async.
    Every method gets all body slots (json/data/files/content): OpenAPI allows
    a requestBody on any method, and the slots must exist at runtime or bodies
    would silently vanish into **kwargs. #}
{% macro client_class(class_name, httpx_class, is_async) %}
{%- set adef = "async def" if is_async else "def" %}
{%- set aw = "await " if is_async else "" %}
{%- set mw_type = "AsyncMiddlewareT" if is_async else "MiddlewareT" %}
{%- set handler_type = "AsyncHandlerT" if is_async else "HandlerT" %}
class {{ class_name }}:
    def __init__(self, base_url: str, **kwargs: Any) -> None:
        """
        Initializes the client.

        :param base_url: The base URL for the API.
        :param kwargs: Additional arguments passed directly to
                       `httpx.{{ httpx_class }}`. Use this to set `headers`,
                       `auth`, `timeout`, etc.
        """
        self.base_url = base_url
        self.client = httpx.{{ httpx_class }}(base_url=base_url, **kwargs)
        self._middlewares: list[{{ mw_type }}] = []

    def add_middleware(self, middleware: {{ mw_type }}) -> None:
        """
        Adds a middleware to the client.

        The middleware should be a {% if is_async %}coroutine {% endif %}function with the signature:
        (request: httpx.Request, call_next: {{ handler_type }}) -> httpx.Response

        :param middleware: The middleware function to add.
        """
        self._middlewares.append(middleware)

    def middleware(self, func: {{ mw_type }}) -> {{ mw_type }}:
        """
        Decorator to add a middleware. See `add_middleware` for details.

        :param func: The middleware function to add.
        """
        self.add_middleware(func)
        return func

    {%- for method_name in ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"] %}
    {%- set method_ops = operations | selectattr("method", "equalto", method_name) | list %}

    # -------------------------------------------------------------------------
    # {{ method_name }} Operations
    # -------------------------------------------------------------------------
    {%- for op in method_ops %}

    @overload
    {{ adef }} {{ method_name }}(
            self,
            path: Literal["{{ op.path }}"],
            {%- if op.args %}
            *,
            {%- endif %}
            {%- for p in op.args %}
            {{ p.name }}: {{ p.type }} = {{ p.default }},
            {%- endfor %}
    ) -> Response[{{ op.responses.success_type }}, {{ op.responses.error_type }}]:
        """
        {{ op.doc | default(op.path, true) | wordwrap(72) | indent(8) }}
        """
        ...
    {%- endfor %}
    {%- if method_ops %}

    @overload
    {{ adef }} {{ method_name }}(
            self,
            path: str,
            *,
            json: Any = None,
            data: Any = None,
            files: Any = None,
            content: Any = None,
            **kwargs: Any,
    ) -> Response[Any, Any]:
        """
        Untyped escape hatch for paths not defined in the OpenAPI spec.
        """
        ...
    {%- endif %}

    {{ adef }} {{ method_name }}(
        self,
        path: str,
        *,
        json: Any = None,
        data: Any = None,
        files: Any = None,
        content: Any = None,
        **kwargs: Any,
    ) -> Response[Any, Any]:
        """
        Generic {{ method_name }} implementation.
        """
        return {{ aw }}self._request(
            "{{ method_name }}",
            path,
            json=json,
            data=data,
            files=files,
            content=content,
            params=kwargs,
        )
    {%- endfor %}

    # -------------------------------------------------------------------------
    # Internal Request Logic
    # -------------------------------------------------------------------------
    {{ adef }} _request(
            self,
            method: str,
            path: str,
            json: Any = None,
            data: Any = None,
            files: Any = None,
            content: Any = None,
            params: dict[str, Any] | None = None,
    ) -> Response[Any, Any]:
        request = _prepare_request(
            self.client, method, path, json, data, files, content, params or {}
        )

        # Build the middleware chain
        # We want the last added middleware to wrap the chain first (onion layers)
        # Middleware signature: (request, call_next) -> response
        {{ adef }} send_handler(req: httpx.Request) -> httpx.Response:
            return {{ aw }}self.client.send(req)

        handler: {{ handler_type }} = send_handler
        for middleware in reversed(self._middlewares):
            {{ adef }} wrapped(
                req: httpx.Request,
                next_handler: {{ handler_type }} = handler,
                mw: {{ mw_type }} = middleware,
            ) -> httpx.Response:
                return {{ aw }}mw(req, next_handler)
            handler = wrapped

        res = {{ aw }}handler(request)
        return Response(res)
{% endmacro %}

{% if sync_client -%}
{{ client_class("Client", "Client", false) }}
{%- endif %}

{% if async_client -%}
{{ client_class("AsyncClient", "AsyncClient", true) }}
{%- endif %}
